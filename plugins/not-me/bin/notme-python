#!/usr/bin/env bash
# Find a working Python 3.9+ and exec it with the given arguments.
#
#   bash notme-python <script.py> [args...]
#
# Tries python3, python, then `py -3` (Windows launcher). Each candidate is
# probed first, which skips the Windows Store stub (it exits non-zero without
# running anything) and Python 2 or anything older than 3.9.
# On Git Bash, absolute POSIX path arguments are converted to Windows form so
# a native python.exe can open them. Exit 7 when no interpreter is found.
set -u

export PYTHONUTF8=1

if command -v cygpath >/dev/null 2>&1; then
    converted=()
    for a in "$@"; do
        case "$a" in
            /*) converted+=("$(cygpath -w "$a")") ;;
            *) converted+=("$a") ;;
        esac
    done
    set -- "${converted[@]}"
fi

probe() {
    # $@: interpreter command (may be two words, e.g. `py -3`)
    "$@" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 3)' </dev/null >/dev/null 2>&1
}

for cmd in "python3" "python" "py -3"; do
    # shellcheck disable=SC2086 # `py -3` must split into two words
    command -v ${cmd%% *} >/dev/null 2>&1 || continue
    # shellcheck disable=SC2086
    if probe $cmd; then
        # shellcheck disable=SC2086
        exec $cmd "$@"
    fi
done

# builtins only: PATH may be empty here
{
    echo "not-me: no working Python 3.9 or newer found (tried python3, python, py -3)."
    echo "  macOS: install it with \`brew install python\` or from https://www.python.org/downloads/ ."
    echo "  Linux: install your distribution's python3 package (for example \`sudo apt install python3\`)."
    echo "  Windows: install Python from https://www.python.org/downloads/ (not the Microsoft Store),"
    echo "  tick \"Add python.exe to PATH\", then restart Claude Code."
} >&2
exit 7
