#!/usr/bin/env python3
"""A fake `gh` for the subprocess-level test. State: $FAKEGH_STATE, call log: $FAKEGH_CALLS."""
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))

from tests.fakes.fakegh import FakeGitHub, seed_state  # noqa: E402


def main() -> int:
    argv = sys.argv[1:]
    state_path = os.environ.get("FAKEGH_STATE")
    calls_path = os.environ.get("FAKEGH_CALLS")
    if calls_path:
        with open(calls_path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(argv) + "\n")
    state = None
    if state_path and os.path.exists(state_path):
        with open(state_path, encoding="utf-8") as fh:
            state = json.load(fh)
    fake = FakeGitHub(state if state is not None else seed_state())
    code, out, err = fake.serve(argv)
    if state_path:
        with open(state_path, "w", encoding="utf-8") as fh:
            json.dump(fake.state, fh)
    sys.stdout.write(out)
    sys.stderr.write(err)
    return code


if __name__ == "__main__":
    sys.exit(main())
