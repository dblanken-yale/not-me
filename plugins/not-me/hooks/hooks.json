{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Read|NotebookRead|Grep|Glob|LS|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/notme-python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/repo_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/notme-python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/merge_grant.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
